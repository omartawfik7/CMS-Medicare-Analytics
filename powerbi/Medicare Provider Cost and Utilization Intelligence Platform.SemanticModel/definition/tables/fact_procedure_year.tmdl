table fact_procedure_year
	lineageTag: fb785617-d482-4c2b-aae6-85345f9c3065

	measure 'Procedure Total Payments' = SUM(fact_procedure_year[total_medicare_payment])
		formatString: \$#,0
		displayFolder: Procedure
		lineageTag: 1d015681-98d8-46d6-a3b0-67c994eec667

	measure 'Procedure Total Services' = SUM(fact_procedure_year[total_services])
		formatString: #,0
		displayFolder: Procedure
		lineageTag: c3f06abb-ae48-4210-ad94-3e4a8e68887a

	measure 'Procedure Provider Count' = SUM(fact_procedure_year[provider_count])
		formatString: #,0
		displayFolder: Procedure
		lineageTag: dec9d72d-c178-47a0-8752-42e411337f47

	measure 'Procedure Payment per Service' = DIVIDE([Procedure Total Payments], [Procedure Total Services])
		formatString: \$#,0.00
		displayFolder: Procedure
		lineageTag: 657e1d42-79e7-46bc-863c-eac760c6579a

