table fact_provider_year
	lineageTag: dba18a44-c4d9-415b-8294-0ef36f8a0efe

	measure 'Total Medicare Payments' = SUM(fact_provider_year[provider_total_medicare_payment])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 47b39bb0-cc45-484f-a078-06143dc6635b

	measure 'Provider Count' = DISTINCTCOUNT(fact_provider_year[rendering_npi])
		formatString: #,0
		displayFolder: Core
		lineageTag: d099a72a-490b-4fd3-ac32-11051003362d

	measure 'Total Services' = SUM(fact_provider_year[provider_total_services])
		formatString: #,0
		displayFolder: Core
		lineageTag: debbffd3-ac63-4e55-ad14-23b570dcd2e1

	measure 'Total Beneficiary Service-Lines' = SUM(fact_provider_year[provider_total_beneficiaries])
		formatString: #,0
		displayFolder: Core
		lineageTag: 4a84fab7-609b-42b4-94ea-9dedf584c866

	measure 'Total Submitted Charges' = SUM(fact_provider_year[provider_total_submitted_charge])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 8322e61d-c0f2-48fc-917f-0bb330469886

	measure 'Total Allowed Amount' = SUM(fact_provider_year[provider_total_allowed_amount])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 8a865f0a-d01e-475e-8024-9cc728d51743

	measure 'Payment per Provider' = DIVIDE([Total Medicare Payments], [Provider Count])
		formatString: \$#,0
		displayFolder: Core
		lineageTag: 709fedd3-b2c0-4ee1-b1d5-231c2c1461e2

	measure 'Payment per Beneficiary' = DIVIDE([Total Medicare Payments], [Total Beneficiary Service-Lines])
		formatString: \$#,0.00
		displayFolder: Core
		lineageTag: 638c7492-ce0e-46cc-8475-31cd1e89f11a

	measure 'Payment per Service' = DIVIDE([Total Medicare Payments], [Total Services])
		formatString: \$#,0.00
		displayFolder: Core
		lineageTag: a9c90764-c951-4019-a463-1daf94e5122e

	measure 'Payment to Allowed Ratio' = DIVIDE([Total Medicare Payments], [Total Allowed Amount])
		formatString: 0.0%
		displayFolder: Core
		lineageTag: 2e5caf89-c03d-4730-8479-7e91b46e9a2a

	measure 'YoY Payment % Change' =
			VAR CurYear = MAX(fact_provider_year[source_year])
			VAR CurVal = [Total Medicare Payments]
			VAR PrevVal =
				CALCULATE([Total Medicare Payments], fact_provider_year[source_year] = CurYear - 1)
			RETURN
				DIVIDE(CurVal - PrevVal, PrevVal)
		formatString: 0.0%
		displayFolder: Trends
		lineageTag: 00ac80d7-46dd-48bb-9018-545dab327027

	measure 'YoY Services % Change' =
			VAR CurYear = MAX(fact_provider_year[source_year])
			VAR CurVal = [Total Services]
			VAR PrevVal =
				CALCULATE([Total Services], fact_provider_year[source_year] = CurYear - 1)
			RETURN
				DIVIDE(CurVal - PrevVal, PrevVal)
		formatString: 0.0%
		displayFolder: Trends
		lineageTag: ebb7eaa5-5a7b-424e-a721-1eb68da192da

	measure 'Specialty Median Payment per Beneficiary' = AVERAGE(fact_provider_year[specialty_median_payment_per_beneficiary])
		formatString: \$#,0.00
		displayFolder: Benchmarking
		lineageTag: 8f23fcf4-429b-425b-b081-6bb6a2e97f1e

	measure 'Specialty Percentile Rank' = AVERAGE(fact_provider_year[percentile_rank_payment_per_beneficiary])
		formatString: 0.0%
		displayFolder: Benchmarking
		lineageTag: 90159c90-e95f-4783-8724-5bf2ce273456

	measure 'Relative Cost Ratio' = AVERAGE(fact_provider_year[relative_cost_ratio_beneficiary])
		formatString: 0.00
		displayFolder: Benchmarking
		lineageTag: 75322725-3f3f-4343-8281-e62df7805f01

	measure 'Robust Z-Score' = AVERAGE(fact_provider_year[robust_z_payment_per_beneficiary])
		formatString: 0.00
		displayFolder: Benchmarking
		lineageTag: 4db755ce-ee97-4a73-9afc-2c4044369d26

	measure 'Benchmarkable Provider Count' = CALCULATE([Provider Count], fact_provider_year[benchmark_reliable] = TRUE)
		formatString: #,0
		displayFolder: Benchmarking
		lineageTag: 12f2c49f-fbfd-4944-92d0-c0616d92a23c

	measure 'High-Cost Provider Count' = CALCULATE([Provider Count], fact_provider_year[is_high_cost_outlier] = TRUE)
		formatString: #,0
		displayFolder: Outliers
		lineageTag: e102ed98-3115-4191-8e27-a488aacf8219

	measure 'High-Cost Provider Rate' = DIVIDE([High-Cost Provider Count], [Benchmarkable Provider Count])
		formatString: 0.0%
		displayFolder: Outliers
		lineageTag: 94038852-dd2c-48ee-b5ca-6c292f43608e

	measure 'Outlier Methodology Disclaimer' = "Statistical outliers represent unusual utilization or cost patterns relative to peer providers and do not by themselves indicate fraud, waste, abuse, or improper billing."
		displayFolder: Outliers
		lineageTag: 372bf1a6-7a2d-4655-a3dd-0e04ce60b02c

