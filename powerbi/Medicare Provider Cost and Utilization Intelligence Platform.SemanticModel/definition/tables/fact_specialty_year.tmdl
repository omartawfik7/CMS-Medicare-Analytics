table fact_specialty_year
	lineageTag: 3b1a3c78-8c0d-426e-a2cc-adbb398994ed

	measure 'Specialty Total Payments' = SUM(fact_specialty_year[specialty_total_medicare_payment])
		formatString: \$#,0
		displayFolder: Specialty
		lineageTag: 9ace7f57-37ce-42e0-b9d3-21049f18aea6

	measure 'Specialty Provider Count' = SUM(fact_specialty_year[provider_count])
		formatString: #,0
		displayFolder: Specialty
		lineageTag: c462c103-369d-4548-b808-ddac085cc0c3

	measure 'Specialty Share of National Spend' = AVERAGE(fact_specialty_year[specialty_share_of_national_spend])
		formatString: 0.0%
		displayFolder: Specialty
		lineageTag: d188d159-74c7-4ff6-ad46-14716cb89802

	measure 'Specialty Payment per Provider' = DIVIDE([Specialty Total Payments], [Specialty Provider Count])
		formatString: \$#,0
		displayFolder: Specialty
		lineageTag: b4eb5b91-04cf-4e95-9cb0-51cc61623fdb

	column provider_specialty
