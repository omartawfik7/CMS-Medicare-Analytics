		formatString: 0.0%
		lineageTag: acdae5fc-74b3-4327-86bd-7eddb427a8e8
		summarizeBy: none
		sourceColumn: yoy_payment_pct_change

	partition fact_state_year = m
		mode: import
		source =
				let
					Source = Parquet.Document(File.Contents(DataFolder & "fact_state_year.parquet"))
