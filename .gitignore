# Data (large CMS files should never be committed -- see data/README.md)
data/raw/*.csv
data/raw/*.csv.partial
data/*.duckdb
data/*.duckdb.wal
!data/raw/sample_mup_phy_provider_service_2023.csv

# Gold exports for Power BI (regenerated by src/export_gold_for_powerbi.py --
# see powerbi/README.md for exact commands; too large to commit)
powerbi/data/*.parquet
powerbi/data/*.csv

# Power BI Desktop project local-only files (standard PBIP gitignore content --
# Desktop creates .pbi/localSettings.json and .pbi/cache.abf per user/machine
# the first time the project is opened; never source-control these)
**/.pbi/localSettings.json
**/.pbi/cache.abf

# Trained model artifacts (regenerated by src/modeling.py)
models/*.joblib
models/*.json

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store

# Env / secrets
.env
